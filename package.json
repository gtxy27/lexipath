{
  "name": "lexipath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @lexipath/extension dev",
    "build": "bun run --filter @lexipath/extension build",
    "build:chrome": "bun run --filter @lexipath/extension build:chrome",
    "build:firefox": "bun run --filter @lexipath/extension build:firefox",
    "release": "bun scripts/release.mjs",
    "release:skip-build": "bun scripts/release.mjs --skip-build",
    "dict:download": "bun scripts/dictionary/1-download.ts",
    "dict:parse:ecdict": "bun scripts/dictionary/2-parse-ecdict.ts",
    "dict:parse:jmdict": "bun scripts/dictionary/2-parse-jmdict.ts",
    "dict:parse:kaikki": "bun scripts/dictionary/2-parse-kaikki.ts",
    "dict:compress": "bun scripts/dictionary/6-compress.ts",
    "dict:build": "bun scripts/dictionary/build.ts",
    "dict:clean": "bun scripts/dictionary/clean.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p apps/extension/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/dictionary/tsconfig.json --noEmit && tsc -p packages/providers/tsconfig.json --noEmit && tsc -p packages/storage/tsconfig.json --noEmit && tsc -p packages/subtitles/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/chrome": "^0.0.268",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitest/ui": "^4.0.16",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.2",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
