{
  "name": "@lexipath/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "VITE_BROWSER=chrome vite build --mode chrome && VITE_BROWSER=chrome vite build -c vite.config.content.ts --mode chrome",
    "build:firefox": "VITE_BROWSER=firefox vite build --mode firefox && VITE_BROWSER=firefox vite build -c vite.config.content.ts --mode firefox",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lexipath/core": "workspace:*",
    "@lexipath/providers": "workspace:*",
    "@lexipath/subtitles": "workspace:*",
    "@lexipath/dictionary": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webextension-polyfill": "^0.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.12"
  }
}
