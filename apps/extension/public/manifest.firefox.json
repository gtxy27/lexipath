{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "zh_CN",
  "action": {
    "default_popup": "src/ui/popup/index.html",
    "default_title": "LexiPath"
  },
  "options_ui": {
    "page": "src/ui/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "optional_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://www.bilibili.com/*"
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle sidebar"
    },
    "toggle-original": {
      "description": "Toggle original text"
    },
    "toggle-enhance-paused": {
      "description": "Pause/resume web enhancement on current tab"
    },
    "toggle-floating-button": {
      "description": "Toggle floating button"
    },
    "toggle-subtitle-bilingual": {
      "description": "Toggle subtitle bilingual mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "*.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lexipath@example.com",
      "strict_min_version": "109.0"
    }
  }
}
