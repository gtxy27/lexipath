{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "zh_CN",
  "action": {
    "default_popup": "src/ui/popup/index.html",
    "default_title": "LexiPath"
  },
  "options_ui": {
    "page": "src/ui/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "sidePanel",
    "contextMenus"
  ],
  "side_panel": {
    "default_path": "src/ui/sidebar/index.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://www.bilibili.com/*"
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_command_toggleSidebar__"
    },
    "toggle-original": {
      "description": "__MSG_command_toggleOriginal__"
    },
    "toggle-enhance-paused": {
      "description": "__MSG_command_toggleEnhancePaused__"
    },
    "toggle-floating-button": {
      "description": "__MSG_command_toggleFloatingButton__"
    },
    "toggle-subtitle-bilingual": {
      "description": "__MSG_command_toggleSubtitleBilingual__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "*.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
